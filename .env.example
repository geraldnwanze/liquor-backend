APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=liquor
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where uploaded product photos go: "public" locally (run php artisan storage:link; APP_URL must be this API's public
# address) or "cloudinary" (the CLOUDINARY_* values).
PRODUCT_IMAGES_DISK=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: serve through a custom domain or add transformations, e.g. https://res.cloudinary.com/NAME/image/upload/f_auto,q_auto
CLOUDINARY_URL_BASE=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Public address of the storefront (used in emailed links such as password reset)
FRONTEND_URL=http://localhost:3000

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs, or * behind a trusted load balancer).
# Needed for per-client rate limits when the storefront server calls this API on customers' behalf.
TRUSTED_PROXIES=

# Payments. Use each gateway's TEST keys outside production. Secrets never go to the storefront.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" you set in Flutterwave's dashboard webhook settings (must match exactly).
FLUTTERWAVE_SECRET_HASH=
# Local simulator for development only (ignored in production).
PAYMENTS_FAKE_GATEWAY=true

# Local only: one shared password for every demo staff login created by DemoRoleUsersSeeder (leave empty for random ones).
DEMO_STAFF_PASSWORD=
